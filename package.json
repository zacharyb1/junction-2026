{
  "name": "exa-life-events-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:studio": "mastra studio --port 4112 --server-port 4111",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --target=node26 --outfile=dist/server.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "reset": "node scripts/reset.mjs",
    "triage:samples": "tsx --env-file-if-exists=.env scripts/triage-samples.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.44.0",
    "@hono/node-server": "1.19.19",
    "@mastra/core": "1.82.0",
    "@mastra/hono": "1.7.24",
    "@mastra/libsql": "1.29.0",
    "@mastra/memory": "1.41.0",
    "chat": "4.44.0",
    "exa-js": "2.28.0",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "mastra": "1.38.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "packageManager": "pnpm@12.18.0"
}
