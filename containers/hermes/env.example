# Copy to .env.bot (ignored by Git). Never copy an existing live Hermes home.
# One active host/container per Telegram bot token; use another token for testing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
NVIDIA_API_KEY=

# After /sethome in your group, set the numeric group ID and recreate Hermes.
# KAVERI_TELEGRAM_CHAT_ID=-1001234567890

# Optional demo access; leave off unless the bot should answer strangers.
# TELEGRAM_ALLOW_ALL_USERS=true
# TELEGRAM_GROUP_ALLOWED_USERS=*

# CASEFILE_SECRET and EXA_API_KEY come from .env.local via Compose.
# The Engine and gate URLs are internal Compose service addresses, also set there.
