# Allow only the inputs needed to build the web app. Private runtime state,
# env files, agent worktrees and host dependencies never enter the build context.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.ts
!tsconfig.json
!eslint.config.mjs
!src/
!src/**
!public/
!public/**
# Reviewed synthetic recorded cases only; never include arbitrary eval/private runtime output.
!eval/
!eval/results/
!eval/results/2026-11-14T05-01-11-265Z.json
!scripts/
!scripts/prepare-recorded-seed.mjs
!scripts/restore-recorded-seed.mjs
!scripts/restore-cases.mjs
# Keep future env/key files out even if added under an allowed source directory.
**/.env*
**/*.pem
**/*.key
