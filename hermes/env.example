# Kaveri: variables for ~/.hermes/.env
#
# Add these lines to the .env that Hermes already has. Do not replace that file: `hermes model` and
# `hermes gateway setup` write their own entries there. `hermes config env-path` prints its location.
# Never commit a filled-in copy. Values below are placeholders.

# --- Model provider: written by `hermes model`. Listed so you know which line to look for. ---
# One of these, depending on the provider you picked:
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# --- Telegram ---
# Bot token from @BotFather (/newbot). `hermes gateway setup` writes it for you.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (ask @userinfobot). Comma-separated for several people. These users may also DM the bot.
TELEGRAM_ALLOWED_USERS=
# Written by /sethome in the family group. Reminders and the daily change watch are delivered there. Do not set by hand.
# TELEGRAM_HOME_CHANNEL=

# --- Exa ---
# Used twice: Hermes web_search/web_extract (web.backend: exa) and the x-api-key header of the Exa MCP server.
EXA_API_KEY=

# --- Case engine (our web app) ---
# Copy both lines from .env.bot in the repo root. That file is not committed: get it from whoever deployed the web app.
# MCP endpoint of the deployed app, ending in /api/mcp. Used as mcp_servers.casefile.url.
CASEFILE_URL=https://junction-2026.vercel.app/api/mcp
# Shared secret, sent as "Authorization: Bearer <value>". Must equal CASEFILE_SECRET in the Vercel project.
CASEFILE_SECRET=

# --- Judge mode: leave commented until you need it (README, "Judge mode") ---
# Groups other than the family group: the bot answers only when @mentioned, every turn.
# TELEGRAM_GUEST_MODE=true
# Lets any sender trigger the bot in groups (not in DMs). Needed with guest mode for people who are not in TELEGRAM_ALLOWED_USERS.
# TELEGRAM_GROUP_ALLOWED_USERS=*
# Lets anyone DM the bot. Demo hours only, then remove it and restart the gateway.
# TELEGRAM_ALLOW_ALL_USERS=true
