// Development container. Works in VS Code, Cursor and the devcontainer CLI, on Apple Silicon and x86.
// Development only: production uses the root Dockerfile. The two share the Node version and nothing else.
{
  "name": "exa-life-events-bot",

  // Official Node 22 + TypeScript image, pinned. This tag ships Node 22.23.5, the version in .nvmrc.
  // When bumping Node, change .nvmrc, this tag and NODE_VERSION in the Dockerfile together.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.2.6-22-bookworm",
  "remoteUser": "node",

  // node_modules and the pnpm store live on named volumes, not on the bind-mounted workspace,
  // so installs are fast on macOS and Windows and never mix with host-built binaries.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-pnpm-store,target=/pnpm-store,type=volume"
  ],

  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "PNPM_STORE_DIR": "/pnpm-store"
  },

  // Fresh named volumes are owned by root; hand them to the node user.
  // corepack then provides the exact pnpm version from package.json's "packageManager" field.
  "onCreateCommand": "sudo chown node:node node_modules /pnpm-store && sudo corepack enable && pnpm config set store-dir /pnpm-store --location=global",
  "postCreateCommand": "pnpm install",

  "forwardPorts": [4111, 4112],
  "portsAttributes": {
    "4111": { "label": "Hono app (Mastra API + bot routes)", "onAutoForward": "notify" },
    "4112": { "label": "Mastra Studio", "onAutoForward": "silent" }
  },

  // No secrets here or in the image. The app reads the gitignored .env in the workspace at runtime,
  // and the LibSQL file lives in the gitignored data/ folder, so both survive container rebuilds.
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "VoidZero.vite-plus-extension-pack"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },
        "oxc.fmt.disableNestedConfig": true,
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.preferences.importModuleSpecifier": "relative",
        "files.eol": "\n"
      }
    }
  }
}
