# Copy to .env and fill in. .env is gitignored; never commit or paste real values.

# --- Telegram -------------------------------------------------------------
# Token of YOUR OWN dev bot from @BotFather. One token can be polled by only
# one process, so every developer needs their own bot.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @ (used to detect mentions).
TELEGRAM_BOT_USERNAME=
# Comma-separated numeric Telegram user IDs allowed to trigger the bot.
# Leave empty to allow everyone who can reach the bot (fine for a private test group).
TELEGRAM_ALLOWED_USER_IDS=
# Optional: chat that receives monitor alerts, e.g. telegram:-1001234567890.
# When empty, alerts go to the last group the bot saw a message in.
TELEGRAM_DEMO_CHAT_ID=

# --- Exa ------------------------------------------------------------------
# API key from https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# One-time webhookSecret returned by exa.monitors.create(); verifies
# the Exa-Signature header on POST /webhooks/exa-monitor.
EXA_WEBHOOK_SECRET=
# Cache Exa responses on disk in data/exa-cache (on|off). Default: on, except in production.
EXA_CACHE=on

# --- Model ----------------------------------------------------------------
# Mastra model router id, "provider/model". Swap freely; set the matching key below.
MODEL=anthropic/claude-sonnet-5-5
# Key for the provider named in MODEL (ANTHROPIC_API_KEY for anthropic/*,
# OPENAI_API_KEY for openai/*, GOOGLE_GENERATIVE_AI_API_KEY for google/*).
ANTHROPIC_API_KEY=

# --- Server ---------------------------------------------------------------
# Port of the Hono app (Mastra API + our routes). Studio runs on 4112 in dev.
PORT=4111
# LibSQL database. A local file under data/ survives container rebuilds.
DATABASE_URL=file:./data/mastra.db
