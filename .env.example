# Copy to .env.local (git-ignored). Set the same names in Vercel → Project → Settings → Environment Variables.
# The app uses the first provider whose variable is set (see src/lib/ai.ts).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

