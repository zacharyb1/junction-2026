# Copy to .env.local (git-ignored). Set the same names on the Vercel project.

# Exa: research engine and quote verifier. Redeem EXA50JUNCTION at dashboard.exa.ai/billing.
EXA_API_KEY=

# Shared secret between the bot and this app (Authorization: Bearer ...). Any long random string.
CASEFILE_SECRET=

# Public code for the browser demo: /try?code=...
DEMO_ACCESS_CODE=
# Set to 1 to open the demo (/try, /ukk, /autopilot) to every visitor without the code. The rate limit is then
# what protects the Exa credit, so it is a choice for each deployment. Unset, visitors need the code.
# After changing it, recreate the web container (docker compose --env-file .env.local up -d web); a restart is not enough.
# DEMO_OPEN=1

# Secret for the daily source re-check (GET /api/cron/recheck, scheduled in vercel.json).
# Vercel sends it as "Authorization: Bearer ..." to cron routes. Without it on the project the daily job answers 401.
CRON_SECRET=

# Vercel Blob token. Set automatically on Vercel once the Blob store is connected.
# Leave empty locally to store cases in ./.data instead.
BLOB_READ_WRITE_TOKEN=

# Optional: Oxylabs Web API key. Enables a live read of pages that refuse our own request.
# OXYLABS_API_KEY=

# Optional: ElevenLabs key. Enables "Listen to the plan" on the case page and GET /api/cases/<id>/audio.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb           # voice for the spoken plan (default: George)

# Optional
# PUBLIC_BASE_URL=https://junction-2026.vercel.app   # origin used in case links
# NEXT_PUBLIC_BOT_USERNAME=                          # Telegram bot username for the QR code
# NEXT_PUBLIC_SAMPLE_CASE_ID=                        # sample case linked from the landing page
# NEXT_PUBLIC_REPO_URL=                              # source link in the footer
# DEMO_RATE_PER_MINUTE=20                            # public demo requests per client address per minute
# DEMO_RATE_TOTAL_PER_MINUTE=40                      # all public demo requests per minute
# DEMO_RATE_TOTAL_PER_DAY=1000                       # all public demo requests in 24 hours

# Docker Compose on a server (docs/CONTAINERS.md#using-a-server). Read by Compose, not by the app.
# KAVERI_DOMAIN=                                     # public hostname for the HTTPS proxy (--profile public)
# KAVERI_RESTART=unless-stopped                      # restart after crash/reboot; dedicated server only
# KAVERI_ENGINE_URL=https://junction-2026.vercel.app/api/mcp  # bot uses another Engine (its CASEFILE_SECRET)
# KAVERI_HTTP_PORT=3000                              # host loopback port of the web container
# KAVERI_COMMIT=                                     # set by the server deploy script; shown in /api/health

# Only used by the scaffold's /api/chat endpoint, which needs CASEFILE_SECRET. Its /chat page is removed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
